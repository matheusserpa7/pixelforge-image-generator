includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: max

    # Published unchanged from laravel/pulse; analysed upstream.
    excludePaths:
        - database/migrations/*_create_pulse_tables.php
