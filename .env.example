# -----------------------------------------------------------------------------
# pixelforge-studio environment.
#
# Development: the app container copies this file to .env and generates
# APP_KEY on first start. Values below work with compose.yaml as they are.
# Production: create .env on the server with real values (never commit it).
# Comments sit on their own line: inline comments are not portable between
# Laravel and Docker Compose.
# -----------------------------------------------------------------------------

# --- Application --------------------------------------------------------------
APP_NAME="Pixelforge Studio"
# local | production
APP_ENV=local
# Generated by `php artisan key:generate`. Required.
APP_KEY=
# Always false in production.
APP_DEBUG=true
# Public URL of the app (used for links and redirects).
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Host ports published by Docker Compose.
APP_PORT=8080
VITE_PORT=5173

# --- Logging ------------------------------------------------------------------
# `json` writes one JSON object per line to stdout (docs/adr/0019-observability.md).
LOG_CHANNEL=json
LOG_DEPRECATIONS_CHANNEL=null
# debug | info | notice | warning | error
LOG_LEVEL=debug

# --- Database (MySQL 8.4) ------------------------------------------------------
DB_CONNECTION=mysql
# `mysql` is the Compose service name.
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pixelforge
DB_USERNAME=pixelforge
# Local development only. Use strong, unique values in production.
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# --- Redis (queues, cache, sessions, locks) -------------------------------------
REDIS_CLIENT=phpredis
# `redis` is the Compose service name.
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Session cookies are Secure (HTTPS only) when APP_ENV=production unless overridden.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
# Where generated images are stored (docs/adr/0013-image-storage.md).
FILESYSTEM_DISK=local

# --- Mail (only password reset emails; logged locally) ---------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- S3-compatible storage (optional, for FILESYSTEM_DISK=s3) --------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Pixelforge (docs/product/pixelforge-api.md) ---------------------------------
PIXELFORGE_BASE_URL=https://pixelforge.promptedit.dev/v1
# One API key per environment, from the Pixelforge dashboard. Secret.
PIXELFORGE_API_KEY=
# Signing secret (whsec_...) of that same key. Secret.
PIXELFORGE_WEBHOOK_SECRET=
# Reject webhooks whose signature timestamp is older than this many seconds.
PIXELFORGE_WEBHOOK_TOLERANCE=300

# --- Billing (docs/adr/0004-markup-and-rounding.md) -------------------------------
# Percentage added on top of the Pixelforge cost. Integer or decimal string.
BILLING_MARKUP_PERCENT=25

# --- Monitoring ---------------------------------------------------------------
# Sentry is disabled unless a DSN is set.
SENTRY_LARAVEL_DSN=
PULSE_ENABLED=true

VITE_APP_NAME="${APP_NAME}"
